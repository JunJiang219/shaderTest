// eff-template.effect —— 2D 精灵最小模板
CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert      # 顶点着色器入口
      frag: sprite-fs:frag      # 片元着色器入口
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        shineColor: { value: [1, 1, 1, 1], editor: { type: color } }
        shineWidth: { value: 30, editor: { slide: true, range: [1, 300], step: 1 } }
        shineSpeed: { value: 300, editor: { slide: true, range: [0, 1000], step: 1 } }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>          // 拿到全局矩阵/时间
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>         // 拿到模型矩阵 cc_matWorld
  #endif

  // 顶点输入（来自精灵网格）
  in vec3 a_position;   // 顶点位置
  in vec2 a_texCoord;   // UV
  in vec4 a_color;      // 顶点颜色（精灵的 color 属性）

  // 传给片元着色器的数据
  out vec2 uv0;
  out vec4 color;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;                   // 模型 → 世界
    #endif
    pos = cc_matViewProj * pos;                  // 世界 → 裁剪空间

    uv0 = a_texCoord;                            // UV 传下去
    color = a_color;                             // 顶点色传下去
    return pos;                                  // 返回最终位置
  }
}%

CCProgram sprite-fs %{
  // WebGL 1 需要显式启用导数扩展；WebGL 2 / 原生平台使用内置导数函数。
  #if __VERSION__ < 300
    #extension GL_OES_standard_derivatives : enable
  #endif

  precision highp float;
  #include <builtin/internal/embedded-alpha>     // 处理图集的 alpha
  #include <builtin/internal/alpha-test>         // 提供 ALPHA_TEST 宏
  #include <builtin/uniforms/cc-global>          // cc_time 头文件

  in vec2 uv0;
  in vec4 color;

  // 精灵贴图：Cocos 2D 约定用 cc_spriteTexture，引擎会自动把 Sprite 的图喂进来
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

  // 接收材质面板上的 mainColor 参数
  uniform Constant {
    vec4 shineColor;   // 流光颜色（通常偏白）
    float shineWidth;  // 流光从中心到边缘的宽度，单位：屏幕像素
    float shineSpeed;  // 流光沿法线方向的移动速度，单位：屏幕像素/秒
  };

  // 计算对角线坐标每跨过一个屏幕像素会变化多少 UV。
  // 使用屏幕导数后，材质不需要额外传入 Sprite 或纹理尺寸。
  float getDiagonalUvPerPixel(float diagonalUv) {
    vec2 uvGradient = vec2(dFdx(diagonalUv), dFdy(diagonalUv));
    return max(length(uvGradient), 0.000001);
  }

  vec4 frag () {
    vec4 o = texture(cc_spriteTexture, uv0) * color;
    // 沿对角线的位置，0~2 之间
    float d = uv0.x + uv0.y;
    float uvPerPixel = getDiagonalUvPerPixel(d);
    float travelDistancePx = 2.0 / uvPerPixel;
    float positionPx = d / uvPerPixel;
    // 亮带以 shineSpeed 像素/秒移动，走完当前 Sprite 后循环。
    float centerPx = mod(cc_time.x * shineSpeed, travelDistancePx);
    // 在像素空间计算距离，使 shineWidth 不再受 Sprite 尺寸影响。
    float band = smoothstep(shineWidth, 0.0, abs(positionPx - centerPx));
    // 叠加流光（只在不透明区域加，乘 o.a）
    o.rgb += shineColor.rgb * band * o.a;
    ALPHA_TEST(o);
    return o;
  }
}%
